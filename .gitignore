# ============================================================
# NAVGUARD — Root .gitignore
# AI-Assisted GNSS-Denied Mobile Navigation & Sensor Fusion
# ============================================================


# ------------------------------------------------------------
# OS-generated files
# ------------------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini


# ------------------------------------------------------------
# IDE / editor files
# ------------------------------------------------------------

.idea/
*.iml
*.ipr
*.iws

*.swp
*.swo

# VS Code settings may later be intentionally committed.
# For now, keep developer-local configuration out of the repo.
.vscode/


# ------------------------------------------------------------
# Logs / temporary files
# ------------------------------------------------------------

*.log
*.tmp
*.temp
*.bak

.history/
.buildlog/


# ------------------------------------------------------------
# Flutter / Dart generated files
# ------------------------------------------------------------

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
.pub-preload-cache/

build/
coverage/

**/doc/api/
**/generated_plugin_registrant.dart

flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds


# ------------------------------------------------------------
# Android local / generated / sensitive files
# ------------------------------------------------------------

.gradle/

**/android/local.properties
**/android/key.properties

**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

*.jks
*.keystore


# ------------------------------------------------------------
# iOS / macOS generated files
# NAVGUARD currently targets Android, but Flutter may generate
# platform directories during development.
# ------------------------------------------------------------

**/ios/**/DerivedData/
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/xcuserdata/
**/ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig

**/macos/**/Pods/
**/macos/**/xcuserdata/
**/macos/Flutter/ephemeral/


# ------------------------------------------------------------
# Windows / Linux Flutter generated files
# ------------------------------------------------------------

**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
.coverage.*
htmlcov/

.ipynb_checkpoints/


# ------------------------------------------------------------
# Secrets / credentials / environment files
# ------------------------------------------------------------

.env
.env.*
!.env.example

secrets/

*.key
*.pem
*.p12
*.pfx

credentials.json
service-account.json


# ------------------------------------------------------------
# NAVGUARD research data
#
# Real raw sensor / GNSS datasets must NOT be committed,
# especially while the repository is public.
# ------------------------------------------------------------

data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/exports/*
!data/exports/.gitkeep


# ------------------------------------------------------------
# NAVGUARD raw experimental evidence
#
# Sanitized summaries, reports, manifests, charts and test
# outputs may be committed outside these raw directories.
# ------------------------------------------------------------

evidence/device_audit/raw/*
!evidence/device_audit/raw/.gitkeep

evidence/benchmarks/raw/*
!evidence/benchmarks/raw/.gitkeep

evidence/final_results/raw/*
!evidence/final_results/raw/.gitkeep


# ------------------------------------------------------------
# Local experimental scratch files
# ------------------------------------------------------------

experiments/local/
experiments/tmp/

tmp/
temp/


# ------------------------------------------------------------
# Large local archives / exports
# ------------------------------------------------------------

*.zip
*.7z
*.rar
*.tar
*.tar.gz


# ------------------------------------------------------------
# IMPORTANT:
#
# Do NOT ignore:
#
# pubspec.lock
# requirements.txt
# pyproject.toml
# uv.lock
# poetry.lock
# Gradle wrapper files
# .tflite final model artifacts
#
# These may be required for reproducibility and should be
# committed intentionally when they become part of NAVGUARD.
# ------------------------------------------------------------